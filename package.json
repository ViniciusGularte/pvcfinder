{
  "name": "pvcfinder",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node -e \"console.log('No build step required for PVC Finder')\"",
    "dev": "node scripts/local-dev-server.js",
    "start": "node scripts/local-dev-server.js",
    "grveye:install": "npm ci --prefix grv-eye",
    "grveye:dev": "npm run demo --prefix grv-eye",
