{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/mods",
      "destination": "/mods.html"
    },
    {
      "source": "/mods/",
      "destination": "/mods.html"
    },
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/analytics/",
      "destination": "/index.html"
    }
  ]
}
