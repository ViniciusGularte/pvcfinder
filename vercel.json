{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/lobby/skin/:name.png",
      "destination": "https://api.theyasked.co/grveye/skin/:name"
    },
    {
      "source": "/lobby",
      "destination": "/lobby-web/index.html"
    },
    {
      "source": "/lobby/",
      "destination": "/lobby-web/index.html"
    },
    {
      "source": "/lobby/:path*",
      "destination": "/lobby-web/:path*"
    },
    {
      "source": "/grveye",
      "destination": "/grv-eye/public/index.html"
    },
    {
      "source": "/grveye/",
      "destination": "/grv-eye/public/index.html"
    },
    {
      "source": "/grveye/:path*",
      "destination": "/grv-eye/public/:path*"
    }
  ]
}
