# ─── Server ───────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
APP_NAME=GRV EYE
# Public path on the existing PVC Finder host.
BASE_PATH=/grveye

# Shared access code for the page. Strongly recommended on a public VPS.
ACCESS_TOKEN=change-me-to-something-long

# Where the page is hosted (comma separated, * wildcards allowed).
# Example: https://grv-eye.vercel.app,https://*.vercel.app
CORS_ORIGINS=
# Also serve the page from this server (false = API only)
SERVE_PAGE=true

# ─── Player source ────────────────────────────────────────
# bluemap   → reads <BLUEMAP_URL>maps/<map>/live/players.json for every map
# squaremap → SOURCE_URL = .../tiles/players.json
# dynmap    → SOURCE_URL = .../up/world/<world>/{ts}
# json      → any JSON, configure JSON_* below
# demo      → fake players, for testing the UI
SOURCE_TYPE=squaremap
BLUEMAP_URL=https://web.peacefulvanilla.club/maps/
# PVC currently exposes a Squaremap/LiveAtlas endpoint here.
SQUAREMAP_URL=https://web.peacefulvanilla.club/maps/
# Map ids to follow. Empty = auto-discover from the selected map source.
WORLDS=

SOURCE_URL=
SOURCE_WORLD=world
JSON_LIST_PATH=players
JSON_NAME_FIELD=name
JSON_X_FIELD=x
JSON_Z_FIELD=z
JSON_WORLD_FIELD=world

# How often to read the map. Keep it at 5000+ — it's someone else's server.
POLL_INTERVAL_MS=5000

# Optional generic flat PNG tile template for custom/dynmap sources.
# Squaremap and BlueMap tiles are discovered and proxied automatically.
TILE_URL=
TILE_SIZE=512
TILE_MAX_ZOOM=3

# ─── History ─────────────────────────────────────────────
DB_FILE=./data/eye.db
HISTORY_RETENTION_DAYS=60
MARKET_DB_FILE=./data/market.db
MARKET_POLL_INTERVAL_MS=60000
MARKET_RETENTION_DAYS=30
RANKINGS_CACHE_MS=300000
# Radius around each shop used by the weekly unique visitor counter.
SHOP_VISITOR_RADIUS=6
# Record a new position when a player moved this many blocks...
PING_MIN_MOVE=6
# ...or at least this often while standing still (seconds)
PING_KEEPALIVE_S=60
# Two sightings further apart than this count as separate visits (minutes)
VISIT_GAP_MIN=3
# Safety cap for one area search
AREA_MAX_ROWS=600000

# ─── Skins ───────────────────────────────────────────────
# Floodgate name prefixes for Bedrock players (used when the UUID is unknown)
BEDROCK_PREFIXES=.,*

# ─── Boot music (file inside public/, empty disables) ──────
MUSIC_FILE=The Batcave _ Brother Eye [kk4oSLA8jD4].mp3
